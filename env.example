# Copy to ~/.config/omega-cal-mail/env and chmod 600.
# Your Proton account (any address on the account works as the mail target).
PROTON_USERNAME=you@proton.me
PROTON_PASSWORD=your-proton-password

# Subject prefix that marks a calendar request (default: cal:)
CAL_PREFIX=cal:

# Fallback inbox scan interval in seconds, used only if Proton's
# event-polling API keeps failing (default: 30)
CAL_POLL_SECONDS=30
